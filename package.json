{
  "name": "the-tuul",
  "version": "1.2.0",
  "description": "Create a decent karaoke video from any song in about 10 minutes.",
  "main": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "dev": "vite --host --config vite.config.dev.ts",
    "build": "vite build --mode production --config vite.config.prod.ts",
    "build-dev": "vite build --config vite.config.dev.ts",
    "watch": "vite build --config vite.config.dev.ts --watch --host",
    "version": "uv version --no-sync $npm_package_version && git add pyproject.toml uv.lock",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incidentist/karaoke_video_tools.git"
  },
  "keywords": [
    "karaoke"
  ],
  "author": "Dan Kurtz <andfurthermore@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/incidentist/karaoke_video_tools/issues"
  },
  "homepage": "https://github.com/incidentist/karaoke_video_tools#readme",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "audiobuffer-to-wav": "^1.0.0",
    "buefy": "^3.1.0",
    "bulma": "^1.0.4",
    "idb-keyval": "^6.2.4",
    "jassub": "2.5.21",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "signalsmith-stretch": "^1.3.2",
    "vue": "^3.5.34",
    "wavesurfer.js": "^8.0.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@ffmpeg/types": "^0.12.4",
    "@playwright/test": "^1.60.0",
    "@types/jsmediatags": "^3.9.6",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdown-it": "^15.0.2",
    "playwright": "^1.60.0",
    "prettier": "3.9.6",
    "railway": "^3.11.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.11",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,cjs,vue,json,jsonc,css,scss,html,md,yaml,yml}": "prettier --write",
    "*.py": [
      "uv run ruff check --fix",
      "uv run ruff format"
    ]
  }
}
