// Copy this file to .env and fill in the values
SECRET_KEY=
DEBUG=
LOGGING_FORMAT=console
TUUL_YOUTUBE_PROXY=
TUUL_DONATE_URL=
TUUL_API_HOSTNAME=""
SEPARATED_TRACKS_BUCKET=

# Separation method used by the API server: "api", "cli", or "compose_provider".
SEPARATION_METHOD=api

# Makes the frontend send every separation request to the API instead of
# running web-audio-separation in the browser. Mobile devices always use the
# API regardless of this flag. It isn't derived from SEPARATION_METHOD above,
# since the frontend is a separate build that can't read SEPARATION_METHOD
# directly.
TUUL_USE_REMOTE_SEPARATION=false
