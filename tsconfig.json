{
    "compilerOptions": {
        "target": "ES2022",
        "sourceMap": true,
        "skipLibCheck": true,
        "strict": false,
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "module": "ES2022",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "paths": {
            "@/*": [
                "./frontend/*",
                "./frontend/lib/*"
            ],
            "@/lib/*": [
                "./frontend/lib/*"
            ]
        },
        "types": [
            "vitest/globals",
            "node",
        ]
    },
    "vueCompilerOptions": {
        "target": 3.5
    }
}